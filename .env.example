# Copy to .env (git-ignored) and adjust for this machine. Used by docker-compose.chatterbox.yml.

TZ=UTC

# Folder holding Chatterbox's config.yaml, voices/, reference_audio/, outputs/ and logs/.
# First run: copy chatterbox/config.audiobook.yaml (as config.yaml, this deployment's
# validated settings — chatterbox/config.yaml is the untouched upstream template) and
# chatterbox/voices/ from this repo into it.
CHATTERBOX_DATA=/srv/audiobooks/chatterbox

# The web UI's own data: queue, library index, logs.
APP_DATA=/srv/audiobooks/app-data

# Where finished audiobooks go (e.g. your Audiobookshelf/BookOrbit audiobook library).
AUDIOBOOK_LIBRARY=/srv/media/audiobooks

# EPUB library for the searchable Book picker (read-only).
EBOOK_LIBRARY=/srv/media/ebooks

# Voice selected by default in the UI (a file in CHATTERBOX_DATA/voices).
DEFAULT_VOICE=Emily.wav

# Optional second engine (Kokoro-FastAPI), e.g. http://kokoro:8880/v1. Leave blank (the default)
# to hide the Engine choice entirely and behave exactly as without Kokoro.
KOKORO_BASE_URL=

# Kokoro voice id selected by default (e.g. af_heart). Leave blank to use the server's own
# default_voice, else "af_heart".
KOKORO_DEFAULT_VOICE=

# Existing Docker network shared with anything else that calls Chatterbox (e.g. a reader app).
DOCKER_NETWORK=tts

# Name of the Docker volume holding downloaded models.
HF_CACHE_VOLUME=chatterbox-hf-cache

# Host ports.
CHATTERBOX_PORT=8004
APP_PORT=7860
